{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/icon/**",
              "components/layout/**",
              "components/lists/**",
              "components/media/**",
              "components/navigation/**",
              "components/type/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|tone|indent|maxWidth|children|className|style|key|ref|className|style|children)$/]",
        "message": "<BodyText> doesn't accept that prop. Declared props: as, size, tone, indent, maxWidth, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|div|span)$/]",
        "message": "<BodyText> as must be one of 'p' | 'div' | 'span'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lead|body|small)$/]",
        "message": "<BodyText> size must be one of 'lead' | 'body' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<BodyText> tone must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconPosition|magnetic|fullWidth|href|target|onClick|disabled|type|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconPosition, magnetic, fullWidth, href, target, onClick, disabled, type, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<Button> iconPosition must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|heading|email|links|note|key|ref|className|style|children)$/]",
        "message": "<ContactBlock> doesn't accept that prop. Declared props: index, label, heading, email, links, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|lines|children|reveal|delay|drift|muted|className|style|key|ref|className|style|children)$/]",
        "message": "<DisplayHeading> doesn't accept that prop. Declared props: as, size, lines, children, reveal, delay, drift, muted, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|p|div)$/]",
        "message": "<DisplayHeading> as must be one of 'h1' | 'h2' | 'h3' | 'p' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mega|display|h1|h2|h3)$/]",
        "message": "<DisplayHeading> size must be one of 'mega' | 'display' | 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ExperienceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:period|current|role|company|location|description|tags|key|ref|className|style|children)$/]",
        "message": "<ExperienceRow> doesn't accept that prop. Declared props: period, current, role, company, location, description, tags."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|external|onClick|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href, external, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|mark|role|items|active|onNavigate|status|sticky|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: name, mark, role, items, active, onNavigate, status, sticky."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|label|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, label, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|caption|meta|index|reveal|hover|parallax|placeholder|className|style|key|ref|className|style|children)$/]",
        "message": "<ImagePreview> doesn't accept that prop. Declared props: src, alt, ratio, caption, meta, index, reveal, hover, parallax, placeholder, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePreview'] > JSXAttribute[name.name='hover'] > Literal[value!=/^(?:zoom|mono|none)$/]",
        "message": "<ImagePreview> hover must be one of 'zoom' | 'mono' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|speed|direction|separator|alternate|inverse|bordered|pauseOnHover|className|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: items, size, speed, direction, separator, alternate, inverse, bordered, pauseOnHover, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:display|lg|md|label)$/]",
        "message": "<Marquee> size must be one of 'display' | 'lg' | 'md' | 'label'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Marquee> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<MetaItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|count|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, href, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|client|services|year|image|imageAlt|href|onClick|preview|key|ref|className|style|children)$/]",
        "message": "<ProjectRow> doesn't accept that prop. Declared props: index, title, client, services, year, image, imageAlt, href, onClick, preview."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|variant|accent|rule|aside|animate|className|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: index, label, variant, accent, rule, aside, animate, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:numbered|braces)$/]",
        "message": "<SectionLabel> variant must be one of 'numbered' | 'braces'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|key|ref|className|style|children)$/]",
        "message": "<SkillItem> doesn't accept that prop. Declared props: label, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|suffix|label|index|note|countUp|duration|size|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, suffix, label, index, note, countUp, duration, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<Stat> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|external|icon|tone|size|underline|onClick|className|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, external, icon, tone, size, underline, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted)$/]",
        "message": "<TextLink> tone must be one of 'default' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<TextLink> size must be one of 'sm' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
